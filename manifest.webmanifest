{
  "id": "./",
  "name": "ביאלה – מערכת תמלול הקלטות",
  "short_name": "ביאלה",
  "description": "תמלול הקלטות וסרטונים בעברית, יידיש ואנגלית – מסונכרן בין המחשב לטלפון",
  "lang": "he",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0a1028",
  "theme_color": "#1b2a4e",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "video/*",
            ".opus",
            ".ogg",
            ".oga",
            ".m4a",
            ".mp3",
            ".wav",
            ".aac",
            ".amr",
            ".webm",
            ".mp4",
            ".3gp",
            ".mov",
            ".mkv",
            ".avi",
            ".m4v"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "תמלול חדש",
      "short_name": "תמלול",
      "url": "./?go=home",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "הספרייה",
      "short_name": "ספרייה",
      "url": "./?go=library",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "לוח עברי",
      "short_name": "לוח",
      "url": "./?go=calendar",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "פרשיות",
      "short_name": "פרשיות",
      "url": "./?go=parshiyot",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}